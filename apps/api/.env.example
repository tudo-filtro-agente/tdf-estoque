# ===== SUPABASE =====
# Acesse: https://supabase.com/dashboard/project/oaruxgwmrljgghbvswwj/settings/api-keys
# Use a aba "Legacy anon, service_role API keys"

# URL do projeto Supabase
SUPABASE_URL=https://oaruxgwmrljgghbvswwj.supabase.co

# Chave pública (anon) - pode ser exposta no frontend
SUPABASE_ANON_KEY=COLE_SUA_CHAVE_ANON_AQUI

# Chave privada (service_role) - NUNCA exponha! Só backend
SUPABASE_SERVICE_ROLE_KEY=COLE_SUA_SERVICE_ROLE_AQUI

# ===== SERVIDOR =====
PORT=3001
HOST=0.0.0.0

# URL do frontend (para CORS)
ALLOWED_ORIGIN=http://localhost:5173

# ===== NODE ENV =====
NODE_ENV=development
